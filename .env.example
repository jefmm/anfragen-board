# Kopiere diese Datei nach `.env.local` und trage deine eigenen Werte ein.
# Alle Werte findest du im Supabase-Dashboard unter Project Settings -> API Keys.
#
# `.env.local` gehoert NICHT ins Repo. Sie steht in der .gitignore, das ist Absicht.

NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co

# Der "Publishable key" (beginnt mit sb_publishable_). Der darf oeffentlich sein,
# er steht bei jeder Supabase-Anwendung im Browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dein_key

# Der "Secret key" (beginnt mit sb_secret_). Er umgeht saemtliche
# Sicherheitsregeln der Datenbank.
NEXT_PUBLIC_SUPABASE_SECRET_KEY=sb_secret_dein_key
